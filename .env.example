# Generic Postgres names. The Vercel Supabase integration can instead supply
# POSTGRES_URL and POSTGRES_URL_NON_POOLING; SpecGraph recognizes either pair.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional safety label. Set it alongside each database URL so a preview or
# local process cannot accidentally use a database marked for production.
DATABASE_DEPLOYMENT_ENVIRONMENT=development
AUTH_SECRET=

GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
# Base64-encoded 32-byte AES key used to encrypt connector tokens at rest.
CONNECTOR_ENCRYPTION_KEY=
# Random secret Vercel sends when starting the daily source check.
CRON_SECRET=

# Optional. Semantic analysis remains disabled unless a current Vercel AI
# Gateway provider/model ID is deliberately selected. Vercel deployments can
# authenticate with OIDC; local live evaluation uses AI_GATEWAY_API_KEY.
# Current low-cost evaluation example (verified 2026-08-30):
# SPECGRAPH_SEMANTIC_MODEL=openai/gpt-5.6-luna
SPECGRAPH_SEMANTIC_MODEL=
AI_GATEWAY_API_KEY=
# Optional delay between live evaluation calls. Gateway free-tier limits may
# still be too restrictive for the complete 25-case run.
SPECGRAPH_SEMANTIC_EVAL_DELAY_MS=
